module create_surface(path) {
    // Create a surface by connecting points to origin

    polyhedron(
        points = path,
        faces = [
            // Create triangles connecting each point to origin and next point
            for(i = [1:len(path)-1])
                [0, i, i+1],
            // Close the shape by connecting last point back to first
            [0, len(path), 1]
        ]
    );
}


